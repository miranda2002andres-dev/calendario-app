import React from 'react';
import './HomeView.css';

const HomeView = ({ onSelectRacol }) => {
  const racoles = [
    { id: 1, nombre: 'RACOL CARTAGENA', ciudad: 'Cartagena', satelites: 10, domiciliarios: 56, activa: true },
    { id: 2, nombre: 'RACOL BARRANQUILLA', ciudad: 'Barranquilla', satelites: 8, domiciliarios: 42, activa: true },
  ];

  return (
    <div className="home-view">
      <p className="home-subtitle">Selecciona una RACOL para comenzar</p>
      <div className="racol-lista">
        {racoles.map((racol) => (
          <div
            key={racol.id}
            className="racol-card"
            onClick={() => onSelectRacol(racol)}
          >




            <div className="racol-icon">🚀</div>
            <div className="racol-info">
              <h3>{racol.nombre}</h3>
              <p className="racol-ciudad">📍 {racol.ciudad}</p>
              <div className="racol-badges">
                <span className="badge badge-orange">🛰️ {racol.satelites} satélites</span>
                <span className="badge badge-blue">👥 {racol.domiciliarios} domiciliarios</span>
              </div>
            </div>
            <div className="racol-arrow">›</div>
          </div>
        ))}
      </div>
      <div className="racol-counter">
        <span className="counter-dot"></span>
        {racoles.filter(r => r.activa).length} RACOL activas
      </div>
    </div>
  );
};

export default HomeView;

